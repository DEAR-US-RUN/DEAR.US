# Template only. Copy to .env.local (local) or enter each value in the hosting
# provider's encrypted environment settings (Vercel: Project → Settings →
# Environment Variables). Never commit a filled-in copy and never paste real
# values into chat, tickets, or screenshots.
#
# Vite compiles every VITE_* value into the browser bundle. Keep server secrets
# out of them.

# Firebase web configuration. Public by design; it identifies a project,
# it is not an admin credential.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Server only. Use the pooled runtime connection (restricted role) for DATABASE_URL.
# MIGRATION_DATABASE_URL is the schema owner and is used only by npm run db:migrate
# from a trusted terminal; never deploy it.
DATABASE_URL=
MIGRATION_DATABASE_URL=

# Server only. Firebase Admin service-account values from the SAME project as the
# web configuration. The private key may be pasted with literal \n escapes; the
# API converts them to newlines. Do not add or remove characters.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Server only. Exact comma-separated browser origins: scheme + host, no path,
# no trailing slash. Include every host users actually visit, including the
# Vercel production domain and any stable preview domain. No wildcards.
APP_ORIGINS=

# Server only. Generate once:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Back it up in a secret manager. Changing it orphans existing escrow envelopes.
OWNER_ESCROW_KEY=
# Server only. Comma-separated Firebase UIDs. Every owner must also enrol Firebase MFA.
OWNER_UIDS=
# Server only. Generate with: npm run owner:credential
OWNER_CREDENTIAL_SCRYPT=

# Server only. Private, versioned, S3-compatible bucket with least-privilege keys.
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_FORCE_PATH_STYLE=true

# Server only. Long random secret used by the scheduled cleanup endpoint.
CRON_SECRET=

# Server only, optional. HTTPS endpoint for sanitized operational error events.
MONITORING_WEBHOOK_URL=
