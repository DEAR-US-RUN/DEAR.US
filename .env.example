# Copy to .env.local for Vite; also export the server variables for the API.
# Firebase web config is public by design; do not put service-account credentials here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Server only. Use the Neon pooled runtime connection and a separate migration connection.
DATABASE_URL=
MIGRATION_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Exact comma-separated browser origins, e.g. https://app.example.com
APP_ORIGINS=

# Generate once using: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Back it up in a secret manager; losing it prevents owner escrow recovery.
OWNER_ESCROW_KEY=
# Comma-separated Firebase UIDs; every owner must also use enrolled Firebase MFA.
OWNER_UIDS=
# Generate with npm run owner:credential (never use your diary password).
OWNER_CREDENTIAL_SCRYPT=

# Private S3-compatible bucket and least-privilege credentials.
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_FORCE_PATH_STYLE=

# Used solely by the scheduled cleanup endpoint; choose a long random secret.
CRON_SECRET=

# Optional HTTPS endpoint for sanitized operational error events only.
MONITORING_WEBHOOK_URL=
