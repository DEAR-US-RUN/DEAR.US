{
  "name": "dear-us",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "tsx watch server/dev.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:roles": "tsx scripts/create-runtime-role.ts",
    "owner:credential": "tsx scripts/owner-credential.ts",
    "audit:deps": "npm audit --omit=dev",
    "test:storage:setup": "tsx scripts/create-test-bucket.ts"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1159.0",
    "@aws-sdk/s3-presigned-post": "3.1159.0",
    "@aws-sdk/s3-request-presigner": "3.1159.0",
    "express": "5.3.0",
    "firebase": "12.19.0",
    "firebase-admin": "13.10.0",
    "helmet": "8.3.0",
    "lucide-react": "1.63.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/express": "5.0.6",
    "@types/node": "20.19.43",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "5.1.4",
    "autoprefixer": "10.6.2",
    "postcss": "8.5.32",
    "supertest": "7.3.1",
    "tailwindcss": "3.4.17",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6",
    "uuid": "11.1.1"
  }
}
